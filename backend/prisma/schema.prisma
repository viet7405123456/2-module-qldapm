generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  PATIENT
  ADMIN
  DOCTOR
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum ShiftType {
  MORNING
  AFTERNOON
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  COMPLETED
  NO_SHOW
  CANCELLED
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  fullName     String
  phone        String?
  role         Role
  createdAt    DateTime @default(now())

  patientProfile PatientProfile?
  doctor         Doctor?
  appointments   Appointment[]   @relation("PatientAppointments")

  @@map("users")
}

model PatientProfile {
  id          String    @id @default(uuid())
  userId      String    @unique
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  dateOfBirth DateTime?
  gender      Gender?
  address     String?
  idNumber    String?

  @@map("patient_profiles")
}

model Department {
  id          String  @id @default(uuid())
  name        String  @unique
  description String?

  doctors      Doctor[]
  appointments Appointment[]

  @@map("departments")
}

model Doctor {
  id           String  @id @default(uuid())
  userId       String  @unique
  user         User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id])
  title        String?
  bio          String?

  shifts       DoctorShift[]
  appointments Appointment[]

  @@map("doctors")
}

model DoctorShift {
  id                  String    @id @default(uuid())
  doctorId            String
  doctor              Doctor    @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  workDate            DateTime  @db.Date
  shift               ShiftType
  startTime           String
  endTime             String
  slotDurationMinutes Int
  capacityPerSlot     Int

  slots AppointmentSlot[]

  @@unique([doctorId, workDate, shift])
  @@map("doctor_shifts")
}

model AppointmentSlot {
  id            String      @id @default(uuid())
  doctorShiftId String
  doctorShift   DoctorShift @relation(fields: [doctorShiftId], references: [id], onDelete: Cascade)
  startTime     DateTime
  endTime       DateTime
  capacity      Int
  bookedCount   Int         @default(0)

  appointments Appointment[]

  @@index([doctorShiftId])
  @@index([startTime])
  @@map("appointment_slots")
}

model Appointment {
  id           String            @id @default(uuid())
  patientId    String
  patient      User              @relation("PatientAppointments", fields: [patientId], references: [id])
  slotId       String
  slot         AppointmentSlot   @relation(fields: [slotId], references: [id])
  doctorId     String
  doctor       Doctor            @relation(fields: [doctorId], references: [id])
  departmentId String
  department   Department        @relation(fields: [departmentId], references: [id])
  status       AppointmentStatus @default(PENDING)
  reason       String?
  createdAt    DateTime          @default(now())

  @@index([doctorId])
  @@index([patientId])
  @@index([slotId])
  @@map("appointments")
}
