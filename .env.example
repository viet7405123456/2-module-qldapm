# Copy this file to .env and adjust as needed, then run: docker compose up --build

# PostgreSQL
POSTGRES_DB=qldapm
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432

# Backend (NestJS)
JWT_SECRET=change_me_dev_secret
JWT_EXPIRES_IN=1d
BACKEND_PORT=3000
FRONTEND_ORIGIN=http://localhost:8080

# Frontend (served by nginx)
FRONTEND_PORT=8080

# Adminer (web UI to inspect the Postgres database, optional convenience tool)
ADMINER_PORT=8081
